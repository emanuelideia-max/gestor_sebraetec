# Copie para .streamlit/secrets.toml (nunca suba o secrets.toml para o GitHub).

# Produção: com [supabase] preenchido, o app usa o banco e o login do Supabase.
[supabase]
url = "https://SEU-PROJETO.supabase.co"
key = "SUA-CHAVE-ANON"

# Sem [supabase], o app roda em modo local (SQLite em data/local.db) com estes usuários:
[local_users]
"gestor@exemplo.com" = "troque-esta-senha"

# Opcional: chave para assinar o cookie "manter conectado" no modo local.
# Sem ela, o app gera uma em data/.cookie_secret.
# [auth]
# cookie_secret = "uma-frase-longa-e-aleatoria"
# login_liberado = true   # pula o login (só testes, modo local)
